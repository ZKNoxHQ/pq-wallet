# Everything here can also travel in the URL (?root=…&sEcdsa=…&sPq=…&k=2&chainId=11155111), which is how
# one holder sends another the exact arrangement they are looking at.

VITE_CHAIN_ID=11155111
VITE_RPC_URL_11155111=https://sepolia.drpc.org

# the arrangement
# VITE_ROOT=0x...
# VITE_S_ECDSA=0x...
# VITE_S_PQ=0x...
# VITE_K=2

# optional: the policy check on screen (safe/script/DeployLens.s.sol, factory.IMPLEMENTATION())
# VITE_LENS=0x...
# VITE_PQ_IMPLEMENTATION=0x...

# optional: lists the root's pending transactions instead of retyping them.
# A key in a browser bundle is public; the page works without it.
# VITE_SAFE_API_KEY=

# Relayer for the 84 kB transaction, when no wallet extension is present. It pays the gas and authorizes
# nothing. Local and testnet only.
# VITE_RELAYER_KEY_11155111=0x...

# DEVELOPMENT ONLY — software holders, one 32-byte seed each, comma separated. With this set the page can
# sign without a device, and it says so in its footer. Never set it for a real arrangement.
# VITE_HOLDER_SEEDS=18f6d4b2907e5c3a18f6d4b2907e5c3a18f6d4b2907e5c3a18f6d4b2907e5c3a
